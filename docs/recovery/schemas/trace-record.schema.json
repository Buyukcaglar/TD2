{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^TR-(DOS-EGA|DOS-CGA|AMIGA)-[0-9]{6}$"
    },
    "record_type": {
      "const": "trace"
    },
    "edition_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "specified",
        "environment_locked",
        "recorded",
        "repeatability_failed",
        "repeatable",
        "compared",
        "superseded"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "unknown",
        "tentative",
        "supported",
        "strong",
        "refuted"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emulator": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_lock_id": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "disk_manifest_path": {
          "type": "string"
        },
        "disk_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cpu": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "video": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        },
        "dos_environment": {
          "type": "string"
        },
        "loader_policy": {
          "type": "string"
        }
      },
      "required": [
        "emulator",
        "version",
        "tool_lock_id",
        "cpu",
        "memory",
        "video",
        "audio",
        "dos_environment",
        "loader_policy"
      ]
    },
    "start_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cold_boot",
            "program_entry",
            "checkpoint"
          ]
        },
        "description": {
          "type": "string"
        },
        "checkpoint_path": {
          "type": "string"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_trace_id": {
          "type": "string"
        },
        "mutable_files_reset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clock_seed_policy": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description",
        "mutable_files_reset",
        "clock_seed_policy"
      ]
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unresolved",
            "instruction_boundary",
            "pit_cycle",
            "bios_tick",
            "recovered_game_tick"
          ]
        },
        "origin": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "tie_break_order": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "origin",
        "units",
        "tie_break_order"
      ]
    },
    "input_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "integer",
            "minimum": 0
          },
          "timebase": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "timebase",
          "event",
          "value"
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/locator"
            }
          }
        },
        "required": [
          "id",
          "trigger",
          "measurements",
          "locations"
        ]
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exact_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tolerances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pass_rule": {
          "type": "string"
        }
      },
      "required": [
        "normalization",
        "exact_fields",
        "tolerances",
        "excluded_fields",
        "pass_rule"
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "result_path": {
            "type": "string"
          },
          "result_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "repeat_index": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "result_path",
          "result_sha256",
          "repeat_index",
          "result"
        ]
      }
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_runs": {
          "type": "integer",
          "minimum": 3
        },
        "completed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "unproven",
            "passed",
            "failed"
          ]
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "minimum_runs",
        "completed_runs",
        "status",
        "scope"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "record_type",
    "edition_id",
    "status",
    "confidence",
    "claim",
    "evidence",
    "dependencies",
    "gates",
    "unknowns",
    "revision",
    "purpose",
    "environment",
    "start_state",
    "timebase",
    "input_schedule",
    "checkpoints",
    "comparison",
    "runs",
    "repeatability"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testdrive2:recovery:trace:1",
  "title": "Test Drive II trace evidence record",
  "description": "A versioned fixture and measured runs. A specified fixture is not an executed or repeatable oracle.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "type": "string",
          "enum": [
            "packed_file",
            "rebuilt_mz",
            "unpacked_module",
            "tool_segmented",
            "runtime_segmented",
            "resource_file",
            "source",
            "document"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "segment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "segment_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "module_offset": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_load_segment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "tool_profile": {
          "type": "string"
        },
        "analysis_map_id": {
          "type": "string"
        },
        "transform_id": {
          "type": "string"
        },
        "relocation_state": {
          "type": "string",
          "enum": [
            "unrelocated",
            "relocated",
            "not_applicable",
            "unknown"
          ]
        },
        "timepoint": {
          "type": "string"
        },
        "address_policy": {
          "type": "string"
        },
        "container_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "member_path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "coordinate",
        "path"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "coordinate": {
                "enum": [
                  "packed_file",
                  "rebuilt_mz",
                  "unpacked_module",
                  "resource_file"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sha256",
              "offset",
              "length"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate": {
                "enum": [
                  "tool_segmented",
                  "runtime_segmented"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sha256",
              "segment",
              "segment_offset",
              "relocation_state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate": {
                "const": "tool_segmented"
              }
            }
          },
          "then": {
            "required": [
              "tool_profile",
              "analysis_map_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate": {
                "const": "runtime_segmented"
              }
            }
          },
          "then": {
            "required": [
              "runtime_load_segment",
              "timepoint",
              "address_policy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate": {
                "const": "source"
              }
            }
          },
          "then": {
            "required": [
              "line"
            ]
          }
        },
        {
          "if": {
            "required": [
              "member_path"
            ]
          },
          "then": {
            "required": [
              "container_sha256"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "raw_bytes",
            "instruction_analysis",
            "source_comparison",
            "transform_validation",
            "compilation",
            "synthetic_vectors",
            "differential_trace",
            "runtime_observation",
            "visual_review",
            "audio_review",
            "document_review"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "tool_id": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "locator",
        "result",
        "scope"
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "blocking",
        "resolution"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "pending",
            "passed",
            "failed",
            "blocked",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence_ids",
        "scope"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string"
        },
        "edition_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        }
      },
      "required": [
        "description",
        "locators"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static_bytes": {
          "$ref": "#/$defs/gate"
        },
        "code_contract": {
          "$ref": "#/$defs/gate"
        },
        "compilation": {
          "$ref": "#/$defs/gate"
        },
        "differential": {
          "$ref": "#/$defs/gate"
        },
        "runtime": {
          "$ref": "#/$defs/gate"
        },
        "visual": {
          "$ref": "#/$defs/gate"
        },
        "audio": {
          "$ref": "#/$defs/gate"
        },
        "fidelity": {
          "$ref": "#/$defs/gate"
        }
      },
      "required": [
        "static_bytes",
        "code_contract",
        "compilation",
        "differential",
        "runtime",
        "visual",
        "audio",
        "fidelity"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "environment_locked",
              "recorded",
              "repeatability_failed",
              "repeatable",
              "compared"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "required": [
              "executable_sha256",
              "config_path",
              "config_sha256",
              "disk_manifest_path",
              "disk_manifest_sha256"
            ]
          },
          "timebase": {
            "properties": {
              "kind": {
                "not": {
                  "const": "unresolved"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "repeatable",
              "compared"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "runs": {
            "minItems": 3
          },
          "repeatability": {
            "properties": {
              "completed_runs": {
                "minimum": 3
              },
              "status": {
                "const": "passed"
              }
            }
          }
        }
      }
    }
  ]
}
