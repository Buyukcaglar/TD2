/* Windows resources: the app icon, the application manifest and the version information. The icon is
 * the user's own artwork (td2port.ico), not original game media. SDL gives its window class the first
 * icon resource, so it is also the window's and the taskbar's icon. */
#include <winres.h>

1 ICON "td2port.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "td2port.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Test Drive II port (needs the original DOS game files)"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "TD2"
            VALUE "LegalCopyright", "Port code: MIT licence. Game files are not included."
            VALUE "OriginalFilename", "TD2.exe"
            VALUE "ProductName", "Test Drive II port"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
